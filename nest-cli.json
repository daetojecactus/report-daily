{
  "$schema": "https://json.schemastore.org/nest-cli",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "tsConfigPath": "tsconfig.build.json",
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/infrastructure/database/migrations/**/*",
        "watchAssets": true
      }
    ]
  }
}
