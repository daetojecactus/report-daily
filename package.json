{
  "name": "report-daily",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^26.0.0",
    "pnpm": "^12.0.0"
  },
  "scripts": {
    "build": "nest build",
    "dev": "node --watch --enable-source-maps --env-file=.env dist/main.js | pino-pretty",
    "watch": "nest build && concurrently -k -n build,types,app \"nest build --watch\" \"tsc --noEmit --watch --preserveWatchOutput\" \"pnpm dev\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config test/vitest.config.ts --project unit",
    "test:int": "vitest run --config test/vitest.config.ts --project integration",
    "db:generate": "drizzle-kit generate --config src/modules/infrastructure/database/drizzle.config.ts",
    "db:migrate": "nest build && node --env-file=.env dist/migrate.js",
    "preview": "nest build && node --env-file=.env dist/preview.js",
    "golden": "nest build && node --env-file=.env dist/golden.js"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "^4.0.2",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "^2.0.2",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "bullmq": "^6.5.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "nestjs-cls": "^7.0.2",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.20",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
